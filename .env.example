# ============================================================
# HIE â€” Environment Variables
# Copy to .env and fill in real values. Never commit .env.
# ============================================================

# ---- App ----
DEBUG=false
CORS_ORIGINS=["http://localhost:3000"]
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# ---- Supabase ----
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=           # Settings > API > JWT Settings > JWT Secret

# ---- Railway Redis ----
REDIS_URL=redis://default:password@containers-us-west-xxx.railway.app:6379

# ---- OpenAI ----
OPENAI_API_KEY=sk-...

# ---- Anthropic (Phase 2 â€” tutor Q&A) ----
ANTHROPIC_API_KEY=sk-ant-...

# ---- TTS fallback chain (Story 232): 60db -> Sarvam -> Azure -> Browser ----
# ElevenLabs was removed (see CLAUDE.md) — no longer part of the chain.

# 60db.ai (new primary tier)
SIXTYDB_API_KEY=
SIXTYDB_VOICE_ID=              # from GET /voices — no universal default
SIXTYDB_MODEL=60db-quality
SIXTYDB_SPEED=1.0              # 0.5-2.0
SIXTYDB_ENHANCE=true

# Sarvam AI Bulbul v3 (fallback #1)
SARVAM_API_KEY=
SARVAM_VOICE_ID=priya
SARVAM_NARRATION_PACE=0.85     # 0.3-3.0, lower is slower

# Azure Cognitive Services (fallback #2)
AZURE_TTS_KEY=
AZURE_TTS_REGION=centralindia
AZURE_TTS_VOICE=en-IN-NeerjaNeural

# ---- Langfuse (LLM observability, Cloud) ----
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ---- Sentry ----
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# ---- PostHog (product analytics) ----
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# ---- Stripe (payments) ----
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# ---- Cost ceilings (env vars = tunable without redeploy) ----
# Per-lesson ceiling is the only spend control actually enforced today
# (plus the per-user generation-concurrency cap). A daily per-user spend
# cap was documented here but never implemented (D48) -- removed rather
# than left looking like a real control. See docs/DEFECT-REGISTER.md D48.
MAX_LESSON_COST_USD=3.00

# ---- LLM model allocation (per PRD Â§6.4) ----
LLM_LESSON_PLANNER=gpt-4o
LLM_SLIDE_GENERATOR=gpt-4o
LLM_MINI=gpt-4o-mini

# ---- Lesson duration / seat time (Story S5-4) ----
# The T1/T2/T3 tier means TOTAL SEAT TIME (45/30/15 min): narration + quizzes +
# teach-back + tutor Q&A. The split lives in app/schemas/lesson.py; only the
# derived knobs are env-tunable.
# Seconds a student is assumed to spend per MCQ. Divides the tier's quiz budget
# to give the LESSON's total question count (T1 16 / T2 10 / T3 5 at 25 s).
QUIZ_SECONDS_PER_QUESTION=25
# Tutor Q&A phase length per tier, in seconds — the 10% share of seat time.
# Subtracted from the advertised duration, not added on top of it.
LEARNER_TIER_T1_QA_SECONDS=270
LEARNER_TIER_T2_QA_SECONDS=180
LEARNER_TIER_T3_QA_SECONDS=90
LEARNER_TIER_DEFAULT_QA_SECONDS=180

# ---- CES weights (tunable â€” calibrate after 20 sessions, per PRD Â§11) ----
CES_WEIGHT_QUIZ=0.35
CES_WEIGHT_TEACHBACK=0.25
CES_WEIGHT_BEHAVIORAL=0.20
CES_WEIGHT_HEAD_POSE=0.12
CES_WEIGHT_BLINK=0.08
CES_THRESHOLD=50.0

# ---- Intervention limits (per PRD Â§10 guard rules) ----
INTERVENTION_COOLDOWN_SECONDS=120
MAX_DISTRACTION_PER_SESSION=3

